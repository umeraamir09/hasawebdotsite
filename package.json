{
  "name": "hasaweb",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "scripts": {
    "dev": "pnpm build && pnpm dev:runtime",
    "dev:runtime": "wrangler dev -c apps/web/wrangler.jsonc -c apps/site/wrangler.jsonc -c apps/jobs/wrangler.jsonc --persist-to .wrangler/state --port 8787 --ip 127.0.0.1",
    "dev:web": "pnpm --filter @hasaweb/web dev",
    "generate:avatar": "node apps/web/scripts/regenerate-avatar-safe.mjs",
    "test:avatar:browser": "node scripts/avatar-decoration-browser.mjs",
    "local:seed": "node scripts/seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply hasaweb-local --local --config apps/web/wrangler.jsonc --persist-to .wrangler/state",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "spike:render": "node scripts/publish-render-benchmark.mjs",
    "spike:runtime": "node scripts/app-runtime-benchmark.mjs",
    "spike:routing": "node scripts/host-routing-spike.mjs",
    "spike:auth": "node scripts/auth-behavior-spike.mjs",
    "spike:github": "node scripts/github-permissions-spike.mjs",
    "spike:github:live": "node scripts/github-live-oauth.mjs",
    "spike:email": "node scripts/email-delivery-spike.mjs",
    "spike:email:live": "node scripts/email-live.mjs",
    "spike:workflow": "node scripts/workflow-assets-spike.mjs",
    "spike:workflow:live": "node scripts/workflow-assets-live.mjs",
    "spike:workflow:execution:live": "node scripts/workflow-execution-live.mjs",
    "spike:workflow:observe:live": "node scripts/workflow-observe-live.mjs",
    "db:generate": "pnpm --filter @hasaweb/db generate",
    "test:persistence": "node scripts/persistence-integration.mjs",
    "test:auth": "node scripts/auth-integration.mjs",
    "test:auth:browser": "node scripts/auth-integration.mjs --browser",
    "test:owner-runtime": "node scripts/owner-runtime-benchmark.mjs",
    "test:bounded-saves": "node scripts/bounded-save-runtime.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/node": "22.20.5",
    "turbo": "2.11.8",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.151.0"
  }
}
