# Copy the same authentication values configured for web. The named owner API
# verifies the original signed cookie using the same database and signing key.
BETTER_AUTH_SECRET=replace-with-the-same-web-signing-secret
GITHUB_CLIENT_ID=replace-with-local-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-local-github-oauth-client-secret
GOOGLE_CLIENT_ID=replace-with-local-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-local-google-oauth-client-secret
# Separate zero-scope classic personal access token from a dedicated GitHub
# account that owns no portfolio. It reads public contribution calendars only.
GITHUB_SERVICE_TOKEN=replace-with-the-platform-public-read-token
# Optional: the separate private-activity OAuth app (never the sign-in app).
# Callback: {APP_ORIGIN}/api/owner/github/consent/callback. The key is base64
# of 32 random bytes (for example `openssl rand -base64 32`).
GITHUB_ACTIVITY_CLIENT_ID=replace-with-local-activity-oauth-client-id
GITHUB_ACTIVITY_CLIENT_SECRET=replace-with-local-activity-oauth-client-secret
GITHUB_ACTIVITY_KEY=replace-with-base64-of-32-random-bytes
# Optional: send real email through Resend. Without both, local development
# prints emails (including recipient confirmation links) to the jobs console.
# RESEND_API_KEY=replace-with-a-resend-api-key
# EMAIL_FROM=hello@your-verified-sending-domain.example
