{
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "APP_ENV": "local",
    "APP_ORIGIN": "http://127.0.0.1:8787",
    "ASSET_ORIGIN": "https://assets.hasaweb.site"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hasaweb-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "name": "hasaweb-jobs-local",
  "main": "src/index.ts",
  "r2_buckets": [
    {
      "binding": "SITES_BUCKET",
      "bucket_name": "hasaweb-sites-local"
    },
    {
      "binding": "PUBLIC_ASSETS_BUCKET",
      "bucket_name": "hasaweb-assets-local"
    }
  ],
  "workflows": [
    {
      "binding": "PUBLISH_WORKFLOW",
      "name": "hasaweb-publish-local",
      "class_name": "RuntimeWorkflow"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CONTACT_QUEUE",
        "queue": "hasaweb-contact-local"
      },
      {
        "binding": "GITHUB_QUEUE",
        "queue": "hasaweb-github-local"
      },
      {
        "binding": "PUBLICATION_QUEUE",
        "queue": "hasaweb-publication-local"
      }
    ],
    "consumers": [
      {
        "queue": "hasaweb-contact-local",
        "max_batch_size": 1,
        "max_batch_timeout": 1
      },
      {
        "queue": "hasaweb-github-local",
        "max_batch_size": 1,
        "max_batch_timeout": 1
      },
      {
        "queue": "hasaweb-publication-local",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 4
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": "dist/platform",
    "binding": "PLATFORM_ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "PRIVATE_SOURCE",
      "service": "hasaweb-web-local",
      "entrypoint": "PublicationAssets"
    }
  ]
}
