{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["AUTH_SPIKE_CHROMIUM"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["NEXT_TELEMETRY_DISABLED"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@hasaweb/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", ".open-next/**"]
    },
    "@hasaweb/site#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@hasaweb/jobs#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
