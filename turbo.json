{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "AUTH_SPIKE_CHROMIUM",
    "OWNER_RUNTIME_SAMPLES",
    "OWNER_RUNTIME_WARMUPS",
    "OWNER_RUNTIME_CASES",
    "OWNER_RUNTIME_EVIDENCE",
    "BOUNDED_SAVE_EVIDENCE",
    "DRAFT_API_EVIDENCE",
    "GITHUB_PLATFORM_EVIDENCE",
    "RENDERER_EVIDENCE",
    "AUTH_EVIDENCE",
    "RUNTIME_EVIDENCE",
    "XDG_CACHE_HOME",
    "S8_EVIDENCE",
    "S8_BATCH",
    "S8_CASES",
    "S8_MAX_ASSETS",
    "S8_PROFILE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["NEXT_TELEMETRY_DISABLED"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@hasaweb/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", ".open-next/**"]
    },
    "@hasaweb/site#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@hasaweb/jobs#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
